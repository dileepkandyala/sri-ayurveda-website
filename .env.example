# Frontend build settings.
# Copy to .env for local development or .env.production for a production build.
# Files containing real values are ignored by Git.

# Optional: set only when the frontend and API are hosted on different origins.
# For a single-origin deployment (Express serves both), leave unset.
# VITE_API_URL=https://api.example.com/api

# Optional analytics measurement ID.
# VITE_GOOGLE_ANALYTICS_ID=

# Public phone.email widget client IDs, embedded into the frontend build.
PHONE_EMAIL_PHONE_CLIENT_ID=
PHONE_EMAIL_EMAIL_CLIENT_ID=
