# ============================================
# API CONFIGURATION
# ============================================
# For development (backend running locally)
# VITE_API_URL=http://localhost:5000/api

# For production, set to your domain:
VITE_API_URL=https://your-domain.com/api

# Environment
NODE_ENV=production
PORT=5000

# ============================================
# TWILIO WHATSAPP CONFIGURATION (Optional)
# ============================================
# VITE_TWILIO_ACCOUNT_SID=your_account_sid_here
# VITE_TWILIO_AUTH_TOKEN=your_auth_token_here
# VITE_TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
# VITE_RECIPIENT_WHATSAPP_NUMBER=whatsapp:+917619529616

# ============================================
# CONTACT INFORMATION
# ============================================
VITE_CONTACT_EMAIL=contact@example.com
VITE_CONTACT_PHONE=your_phone_number
VITE_CONTACT_WHATSAPP=your_whatsapp_number

# ============================================
# OPTIONAL: ANALYTICS
# ============================================
# VITE_GOOGLE_ANALYTICS_ID=your_ga_id
# VITE_GTM_ID=your_gtm_id

# ============================================
# OPTIONAL: DATABASE / BACKEND SERVICES
# ============================================
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_key
# DATABASE_URL=your_database_connection_string

# ============================================
# SECURITY
# ============================================
# SESSION_SECRET=generate_a_random_string_here