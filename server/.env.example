# Copy this file to .env and fill in your provider credentials for local testing
# Use App Password (create in Google Account > Security > App passwords) with 2FA enabled

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-gmail-app-password
NOTIFY_EMAIL=notifications@example.com
SMTP_FROM=your-email@example.com

# Required for phone OTP delivery
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000

# Optional: change PORT if needed
# PORT=5000