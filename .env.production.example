# Production frontend build settings.
# Copy to .env.production and fill in the phone.email client IDs before building.
# Do not put private credentials in this file.

# Leave unset when Express serves the frontend and /api from the same domain.
# Set this only if the API is hosted separately:
# VITE_API_URL=https://api.example.com/api

# Public phone.email widget IDs (not secrets).
PHONE_EMAIL_PHONE_CLIENT_ID=
PHONE_EMAIL_EMAIL_CLIENT_ID=

# Optional public analytics measurement ID.
# VITE_GOOGLE_ANALYTICS_ID=
